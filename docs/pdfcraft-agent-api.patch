index 0000000..609571f
--- /dev/null
+++ b/crates/ui-egui/src/agent_files.rs
@@ -0,0 +1,44 @@
+//! The agent file table: exports kept in memory for the in-page agent API.
+//!
+//! On the web every save and export becomes a browser download ([`crate::editing::download`]).
+//! A download is a one-way street — the page cannot read it back — so the same bytes are also
+//! stored here, where `window.pdfcraft` (the web app's agent API) lists and reads them:
+//! the last [`MAX_ENTRIES`] files, replaced by name, exactly as delivered to the browser.
+//!
+//! Desktop builds never download, so the table stays empty there.
+
+use std::sync::{Arc, Mutex};
+
+/// How many files the table keeps. Saves and exports both land here; the newest matter.
+pub const MAX_ENTRIES: usize = 32;
+
+type Table = Vec<(String, Arc<Vec<u8>>)>;
+
+static FILES: Mutex<Table> = Mutex::new(Vec::new());
+
+/// Remember `bytes` under `name`, replacing an earlier file of the same name.
+pub fn store(name: &str, bytes: &[u8]) {
+    let mut files = FILES.lock().unwrap_or_else(|e| e.into_inner());
+    files.retain(|(n, _)| n != name);
+    files.push((name.to_string(), Arc::new(bytes.to_vec())));
+    let excess = files.len().saturating_sub(MAX_ENTRIES);
+    files.drain(..excess);
+}
+
+/// The kept files: `(name, size)` oldest first.
+pub fn list() -> Vec<(String, usize)> {
+    FILES.lock().unwrap_or_else(|e| e.into_inner()).iter().map(|(n, b)| (n.clone(), b.len())).collect()
+}
+
+/// A file's bytes, if it is still kept.
+pub fn read(name: &str) -> Option<Arc<Vec<u8>>> {
+    FILES.lock().unwrap_or_else(|e| e.into_inner()).iter().find(|(n, _)| n == name).map(|(_, b)| b.clone())
+}
+
+/// Forget a file. Whether it existed.
+pub fn remove(name: &str) -> bool {
+    let mut files = FILES.lock().unwrap_or_else(|e| e.into_inner());
+    let before = files.len();
+    files.retain(|(n, _)| n != name);
+    files.len() != before
+}
