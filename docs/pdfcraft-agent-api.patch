+        if self.apply_edit(pdfcraft_engine::Edit::ImportData { name: name.to_string(), bytes: Arc::new(bytes) }) {
+            Ok(json!({ "imported": name, "bytes": n }))
+        } else {
+            Err(format!("could not import {name} (XFDF/FDF/XML/CSV/text into the active document; check the format)"))
+        }
+    }
+}
+
+/// A field's kind in the active document, for mapping JSON values (`None`: unknown field).
+impl crate::PdfCraftApp {
+    fn active_field_kind(&self, name: &str) -> Option<pdfcraft_engine::FormFieldKind> {
+        let (_, id) = self.active_ids()?;
+        let doc = self.session.get(id)?;
+        doc.form.iter().find(|f| f.name == name).map(|f| f.kind)
+    }
+}
+
+/// Map a JSON value to a [`FieldValue`] by the field's kind:
+/// strings fill text (a radio's on-state for radio groups), bools tick check boxes,
+/// arrays pick choices, numbers become text, `null` clears a radio group.
+fn agent_field_value(kind: Option<pdfcraft_engine::FormFieldKind>, v: &Value) -> Result<pdfcraft_engine::FieldValue, String> {
+    use pdfcraft_engine::FieldValue;
+    match v {
+        Value::String(s) => match kind {
+            Some(pdfcraft_engine::FormFieldKind::Radio) => Ok(FieldValue::Radio(Some(s.clone()))),
+            _ => Ok(FieldValue::Text(s.clone())),
+        },
+        Value::Bool(b) => Ok(FieldValue::Check(*b)),
+        Value::Number(n) => Ok(FieldValue::Text(n.to_string())),
+        Value::Null => Ok(FieldValue::Radio(None)),
+        Value::Array(a) => Ok(FieldValue::Choice(a.iter().filter_map(Value::as_str).map(str::to_string).collect())),
+        _ => Err("value must be a string, number, bool, array of strings, or null".into()),
+    }
 }
 
