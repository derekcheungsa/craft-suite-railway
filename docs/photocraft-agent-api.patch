diff --git a/crates/engine/src/agent_render_cmds.rs b/crates/engine/src/agent_render_cmds.rs
new file mode 100644
index 0000000..4fde602
--- /dev/null
+++ b/crates/engine/src/agent_render_cmds.rs
@@ -0,0 +1,150 @@
+//! Agent-facing render commands: the composite as bytes, without touching the
+//! document, its history or the view. [`render`](self::render) reuses the
+//! export pipeline (the same flatten Quick Export uses) and answers with
+//! base64, like `swatches.export` without a path; it never captures the screen
+//! or the GPU, so it works in background tabs.
+
+use serde_json::{Value, json};
+
+use crate::commands::CommandSpec;
+use crate::presets::bad;
+use crate::{EngineError, Result, Session};
+
+/// Base64 payloads above this shrink (quality first, then size), as `get_file`
+/// and MCP image content cap at ~1 MB.
+const MAX_B64: usize = 1_000_000;
+
+fn has_doc(s: &Session) -> std::result::Result<(), String> {
+    if s.active().is_some() {
+        Ok(())
+    } else {
+        Err(String::from("no document open"))
+    }
+}
+
+/// `document.render`: the flattened composite of the active document (or one
+/// layer) as encoded bytes, scaled to fit `maxSize` on the long side.
+fn render(s: &mut Session, p: &Value) -> Result<Value> {
+    const CMD: &str = "document.render";
+    if p.get("includeAdjustments").and_then(Value::as_bool) == Some(false) {
+        return Err(bad(CMD, "`includeAdjustments: false` is not supported: renders are always the faithful composite"));
+    }
+    if p.get("region").is_some_and(|v| !v.is_null()) || p.get("scale").is_some_and(|v| !v.is_null()) {
+        return Err(bad(CMD, "`region` and `scale` are not supported yet; use maxSize"));
+    }
+    let format = match p.get("format").and_then(Value::as_str) {
+        Some("png") => "png",
+        Some("jpg") | Some("jpeg") | None => "jpg",
+        Some(f) => return Err(bad(CMD, format!("unknown format `{f}` (jpg|png)"))),
+    };
+    let mut quality = p.get("quality").and_then(Value::as_u64).unwrap_or(80).clamp(1, 100) as u8;
+    let max_size = p.get("maxSize").and_then(Value::as_u64).unwrap_or(1280).clamp(16, 8192) as u32;
+
+    // The document, or just the named layer as a standalone document.
+    let id = if p.get("layer").is_some() {
+        Some(crate::commands::layer_param(s, p)?)
+    } else {
+        None
+    };
+    let d = s.active().ok_or(EngineError::NoDocument)?;
+    let original = match id {
+        Some(id) => crate::layer_menu_cmds::layer_document(&d.doc, id)?,
+        None => (*d.doc).clone(),
+    };
+
+    // Render-and-shrink: quality first, then size. Everything happens on a
+    // scratch session (the app's own resize command), never on the caller's.
+    let original_long = original.size.width.max(original.size.height).max(1);
+    let mut target_long = max_size.min(original_long); // never upscale
+    let name = format!("render.{format}");
+    for _ in 0..8 {
+        let mut doc = original.clone();
+        if target_long < original_long {
+            let mut tmp = Session::new();
+            tmp.add_document(doc, None);
+            let w = (original.size.width as f32 * target_long as f32 / original_long as f32).round().max(1.0);
+            tmp.execute("image.imageSize", json!({"width": w}))?;
+            doc = (*tmp.active().ok_or(EngineError::NoDocument)?.doc).clone();
+        }
+        let opts = photocraft_io::ExportOptions {
+            encode: photocraft_codecs::EncodeOptions { jpeg_quality: quality, ..Default::default() },
+            ..Default::default()
+        };
+        let out = photocraft_io::export(&doc, &name, &opts).map_err(|e| bad(CMD, e.to_string()))?;
+        let b64 = photocraft_paint::tile::b64_encode(&out.bytes);
+        if b64.len() <= MAX_B64 || target_long <= 64 {
+            return Ok(json!({
+                "width": doc.size.width, "height": doc.size.height,
+                "format": format, "quality": if format == "png" { Value::Null } else { json!(quality) },
+                "scaledTo": doc.size.width.max(doc.size.height),
+                "bytes": out.bytes.len(), "warnings": out.warnings, "data": b64,
+            }));
+        }
+        if format == "jpg" && quality > 30 {
+            quality = quality.saturating_sub(20).max(25);
+        } else {
+            target_long = (target_long / 2).max(64);
+            quality = quality.min(60);
+        }
+    }
+    Err(bad(CMD, "could not fit the render under the size cap"))
+}
+
+/// `document.thumbnailGrid`: a coarse average-colour grid of the composite —
+/// one call instead of dozens of `document.sampleColor` round trips.
+fn thumbnail_grid(s: &mut Session, p: &Value) -> Result<Value> {
+    let cols = p.get("cols").and_then(Value::as_u64).unwrap_or(16).clamp(1, 64) as u32;
+    let rows = p.get("rows").and_then(Value::as_u64).unwrap_or(9).clamp(1, 64) as u32;
+    let d = s.active().ok_or(EngineError::NoDocument)?;
+    let img = photocraft_compose::thumbnail(&d.doc, 512);
+    let mut cells = Vec::with_capacity((cols * rows) as usize);
+    for gy in 0..rows {
+        for gx in 0..cols {
+            let x0 = (gx as u64 * img.width as u64 / cols as u64) as usize;
+            let x1 = (((gx + 1) as u64 * img.width as u64 / cols as u64) as usize).max(x0 + 1);
+            let y0 = (gy as u64 * img.height as u64 / rows as u64) as usize;
+            let y1 = (((gy + 1) as u64 * img.height as u64 / rows as u64) as usize).max(y0 + 1);
+            let (mut r, mut g, mut b, mut n) = (0u64, 0u64, 0u64, 0u64);
+            for y in y0..y1.min(img.height as usize) {
+                for x in x0..x1.min(img.width as usize) {
+                    let i = (y * img.width as usize + x) * 4;
+                    r += img.pixels[i] as u64;
+                    g += img.pixels[i + 1] as u64;
+                    b += img.pixels[i + 2] as u64;
+                    n += 1;
+                }
+            }
+            if n == 0 {
+                n = 1;
+            }
+            cells.push(json!([(r / n) as u8, (g / n) as u8, (b / n) as u8]));
+        }
+    }
+    Ok(json!({"cols": cols, "rows": rows, "sample": "average", "cells": cells}))
+}
+
+/// Agent render command specs.
+pub fn specs() -> Vec<CommandSpec> {
+    vec![
+        CommandSpec {
+            id: "document.render",
+            label: "Render Composite (bytes)",
+            menu: &[],
+            shortcut: None,
+            params: r##"{"format":"jpg|png"="jpg","quality":1..100=80,"maxSize":px=1280 (long side; never upscaled),"layer":id? (just that layer)} → {width,height,format,quality,scaledTo,bytes,warnings,data:base64}"##,
+            enabled: has_doc,
+            run: render,
+            journal: false,
+        },
+        CommandSpec {
+            id: "document.thumbnailGrid",
+            label: "Colour Grid",
+            menu: &[],
+            shortcut: None,
+            params: r##"{"cols":1..64=16,"rows":1..64=9,"sample":"average"} → {cols,rows,cells:[[r,g,b],...]}"##,
+            enabled: has_doc,
+            run: thumbnail_grid,
+            journal: false,
+        },
+    ]
+}
