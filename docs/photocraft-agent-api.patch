index 0000000..19cf18a
--- /dev/null
+++ b/apps/photocraft-web/src/api.rs
@@ -0,0 +1,169 @@
+//! `window.photocraft`: the control channel / agent API for the page.
+//!
+//! A port of FilmCraft's web api.rs: the same JSON methods as the desktop
+//! control channel (`photocraft_ui_egui::control`), exposed as promises.
+//! Requests travel over an mpsc channel into `PhotocraftApp`'s existing
+//! `drain_control` per-frame loop (`with_control`), so every method, deadline
+//! and deferred outcome (screenshots, after-input, after-job) behaves exactly
+//! as it does on the desktop control server.
+//!
+//! ```js
+//! await photocraft.execute("layer.new.layer", {})   // engine command → its result
+//! await photocraft.request("ui.inspect")            // control method → its result
+//! await photocraft.commands()                       // command catalog
+//! const shot = await photocraft.screenshot()        // ui.screenshot
+//! photocraft.importBytes("a.png", uint8array)       // deliver a file like a drop
+//! ```
+//!
+//! Results resolve with the method's `result`; errors reject with the message.
+
+use std::cell::RefCell;
+use std::sync::mpsc::{Receiver, Sender, TryRecvError};
+
+use photocraft_ui_egui::ControlRequest;
+use serde_json::{Value, json};
+use wasm_bindgen::prelude::*;
+
+type Waiting = (Receiver<Value>, js_sys::Function, js_sys::Function);
+
+thread_local! {
+    static TX: RefCell<Option<Sender<ControlRequest>>> = const { RefCell::new(None) };
+    static WAITING: RefCell<Vec<Waiting>> = const { RefCell::new(Vec::new()) };
+    static REPAINT: RefCell<Option<eframe::egui::Context>> = const { RefCell::new(None) };
+    static INBOX: RefCell<Option<Sender<(String, Vec<u8>)>>> = const { RefCell::new(None) };
+}
+
+/// Hand the request sender to the API (the receiver goes to `with_control`).
+pub fn set_sender(tx: Sender<ControlRequest>) {
+    TX.with(|t| *t.borrow_mut() = Some(tx));
+}
+
+/// Hand the import-inbox sender to the API (the receiver is drained by WebShell
+/// into the same inbox drag-and-drop uses, so imports open as documents).
+pub fn set_inbox(tx: Sender<(String, Vec<u8>)>) {
+    INBOX.with(|t| *t.borrow_mut() = Some(tx));
+}
+
+/// Refresh the context used to wake the app after a request (every frame).
+pub fn set_context(ctx: &eframe::egui::Context) {
+    REPAINT.with(|r| *r.borrow_mut() = Some(ctx.clone()));
+}
+
+fn to_js(v: &Value) -> JsValue {
+    js_sys::JSON::parse(&v.to_string()).unwrap_or(JsValue::NULL)
+}
+
+fn from_js(v: &JsValue) -> Value {
+    if v.is_undefined() || v.is_null() {
+        return Value::Null;
+    }
+    js_sys::JSON::stringify(v)
+        .ok()
+        .and_then(|s| s.as_string())
+        .and_then(|s| serde_json::from_str(&s).ok())
+        .unwrap_or(Value::Null)
+}
+
+/// Resolve the promises of answered control requests (called every frame).
+pub fn poll_replies() {
+    WAITING.with(|w| {
+        w.borrow_mut().retain(|(rx, resolve, reject)| match rx.try_recv() {
+            Ok(v) => {
+                if v.get("ok").and_then(Value::as_bool) == Some(true) {
+                    let _ = resolve.call1(&JsValue::NULL, &to_js(v.get("result").unwrap_or(&Value::Null)));
+                } else {
+                    let msg = v.get("error").and_then(Value::as_str).unwrap_or("error").to_string();
+                    let _ = reject.call1(&JsValue::NULL, &js_sys::Error::new(&msg));
+                }
+                false
+            }
+            Err(TryRecvError::Empty) => true,
+            Err(TryRecvError::Disconnected) => {
+                let _ = reject.call1(&JsValue::NULL, &js_sys::Error::new("request dropped"));
+                false
+            }
+        });
+    });
+}
+
+/// Send a control request; the promise settles when the UI thread answers it.
+fn request(method: &str, params: Value) -> js_sys::Promise {
+    let method = method.to_string();
+    let p = js_sys::Promise::new(&mut |resolve, reject| {
+        let (req, rx) = ControlRequest::new(method.clone(), params.clone());
+        let sent = TX.with(|t| t.borrow().as_ref().map(|tx| tx.send(req).is_ok()).unwrap_or(false));
+        if sent {
+            WAITING.with(|w| w.borrow_mut().push((rx, resolve, reject)));
+        } else {
+            let _ = reject.call1(&JsValue::NULL, &js_sys::Error::new("PhotoCraft is not running yet"));
+        }
+    });
+    REPAINT.with(|r| {
+        if let Some(ctx) = r.borrow().as_ref() {
+            ctx.request_repaint();
+        }
+    });
+    p
+}
+
+fn set_fn(obj: &js_sys::Object, name: &str, f: JsValue) -> Result<(), JsValue> {
+    js_sys::Reflect::set(obj, &name.into(), &f).map(|_| ())
+}
+
+/// Install `window.photocraft`.
+pub fn install() -> Result<(), JsValue> {
+    let obj = js_sys::Object::new();
+    set_fn(
+        &obj,
+        "request",
+        Closure::<dyn Fn(String, JsValue) -> js_sys::Promise>::new(|method: String, params: JsValue| {
+            let p = from_js(&params);
+            request(&method, if p.is_null() { json!({}) } else { p })
+        })
+        .into_js_value(),
+    )?;
+    set_fn(
+        &obj,
+        "execute",
+        Closure::<dyn Fn(String, JsValue) -> js_sys::Promise>::new(|command: String, params: JsValue| {
+            let p = from_js(&params);
+            request("engine.execute", json!({"command": command, "params": if p.is_null() { json!({}) } else { p }}))
+        })
+        .into_js_value(),
+    )?;
+    set_fn(&obj, "commands", Closure::<dyn Fn() -> js_sys::Promise>::new(|| request("engine.commands", json!({}))).into_js_value())?;
+    set_fn(&obj, "inspect", Closure::<dyn Fn() -> js_sys::Promise>::new(|| request("ui.inspect", json!({}))).into_js_value())?;
+    set_fn(
+        &obj,
+        "screenshot",
+        Closure::<dyn Fn(JsValue) -> js_sys::Promise>::new(|params: JsValue| {
+            let p = from_js(&params);
+            request("ui.screenshot", if p.is_null() { json!({}) } else { p })
+        })
+        .into_js_value(),
+    )?;
+    // Deliver a file exactly like a drag-and-drop: the app's inbox opens it as
+    // a document (or preset library) on a following frame. Returns immediately.
+    set_fn(
+        &obj,
+        "importBytes",
+        Closure::<dyn Fn(String, js_sys::Uint8Array) -> JsValue>::new(|name: String, bytes: js_sys::Uint8Array| {
+            let sent = INBOX
+                .with(|t| t.borrow().as_ref().map(|tx| tx.send((name.clone(), bytes.to_vec())).is_ok()).unwrap_or(false));
+            REPAINT.with(|r| {
+                if let Some(ctx) = r.borrow().as_ref() {
+                    ctx.request_repaint();
+                }
+            });
+            if sent {
+                to_js(&json!({"ok": true, "name": name, "delivered": "inbox"}))
+            } else {
+                js_sys::Error::new("PhotoCraft is not running yet").into()
+            }
+        })
+        .into_js_value(),
+    )?;
+    let w = web_sys::window().ok_or("no window")?;
+    js_sys::Reflect::set(&w, &"photocraft".into(), &obj)?;
+    Ok(())
+}
