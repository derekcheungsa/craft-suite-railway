+//! An in-memory file table for the web build: engine exports that "write a
+//! path" land here (there is no file system in the browser), and the page's
+//! agent API (`window.photocraft.files` / `readFile`) reads them back so the
+//! MCP bridge can `get_file` / `send_file` them.
+
+use std::cell::RefCell;
+
+thread_local! {
+    static FILES: RefCell<Vec<(String, Vec<u8>)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Keep the table bounded: newest writes win, oldest entries drop off.
+const MAX_ENTRIES: usize = 32;
+const MAX_TOTAL_BYTES: usize = 256 * 1024 * 1024;
+
+/// Store `bytes` at `path`, replacing any earlier file with the same path.
+pub fn store(path: &str, bytes: &[u8]) {
+    FILES.with(|f| {
+        let mut f = f.borrow_mut();
+        f.retain(|(p, _)| p != path);
+        f.push((path.to_string(), bytes.to_vec()));
+        while f.len() > MAX_ENTRIES {
+            f.remove(0);
+        }
+        while f.iter().map(|(_, b)| b.len()).sum::<usize>() > MAX_TOTAL_BYTES && f.len() > 1 {
+            f.remove(0);
+        }
+    });
+}
+
+/// `(path, size)` for every stored file, newest last.
+pub fn list() -> Vec<(String, usize)> {
+    FILES.with(|f| f.borrow().iter().map(|(p, b)| (p.clone(), b.len())).collect())
+}
+
+/// The bytes stored at `path`, if any.
+pub fn read(path: &str) -> Option<Vec<u8>> {
+    FILES.with(|f| f.borrow().iter().find(|(p, _)| p == path).map(|(_, b)| b.clone()))
+}
+
+/// Drop `path`; whether it existed.
+pub fn remove(path: &str) -> bool {
+    FILES.with(|f| {
+        let mut f = f.borrow_mut();
+        let before = f.len();
+        f.retain(|(p, _)| p != path);
+        f.len() != before
+    })
+}
